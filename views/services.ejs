<%- include('layout', { body: `
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Manage Services</h2>
        <a href="/admin" class="btn btn-secondary btn-sm">Back to Dashboard</a>
    </div>
    <div class="card mb-4 border-warning shadow-sm">
        <div class="card-body d-flex align-items-center justify-content-between bg-white">
            <div>
                <h6 class="mb-0 text-warning">Data Management</h6>
                <small class="text-muted">Undo your last edit or reset all services to default.</small>
            </div>
            <div class="d-flex gap-2">
                <form action="/admin/undo" method="POST">
                    <input type="hidden" name="file" value="services.json">
                    <button type="submit" class="btn btn-outline-warning btn-sm">Undo Change</button>
                </form>
                <form action="/admin/restore" method="POST" onsubmit="return confirm('Restore all services to default? Current changes will be lost.')">
                    <input type="hidden" name="file" value="services.json">
                    <button type="submit" class="btn btn-outline-danger btn-sm">Restore Defaults</button>
                </form>
            </div>
        </div>
    </div>


    <div class="card mb-4 border-success shadow-sm">
        <div class="card-header bg-success text-white fw-bold">
            <i class="fas fa-plus-circle me-1"></i> Add New Service
        </div>
        <div class="card-body bg-light">
            <form action="/admin/services/add" method="POST" enctype="multipart/form-data">
                <div class="row align-items-end">
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Service Title</label>
                        <input type="text" name="title" class="form-control" placeholder="e.g. Electrical Works" required>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Service Image</label>
                        <input type="file" name="image" class="form-control" required>
                    </div>
                    <div class="col-md-4 mb-3">
                        <button type="submit" class="btn btn-success w-100 fw-bold">Add Service</button>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold">Description</label>
                        <textarea name="description" class="form-control" rows="2" placeholder="Enter a short description of the service..." required></textarea>
                    </div>
                </div>
            </form>
        </div>
    </div>

    
    <div class="row">
        ${services.map(service => `
            <div class="col-12 mb-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <span class="fw-bold fs-5">${service.title}</span>
                        
                        <form action="/admin/services/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this service?');">
                            <input type="hidden" name="id" value="${service.id}">
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </div>
                    <div class="card-body">
                        <form action="/admin/services/update" method="POST" enctype="multipart/form-data">
                            <input type="hidden" name="id" value="${service.id}">
                            
                            <div class="row">
                                <div class="col-md-3 text-center border-end">
                                    <label class="form-label d-block fw-bold text-muted">Current Image</label>
                                    <img src="/${service.image}" class="img-thumbnail mb-2" style="max-height: 150px; object-fit: cover;">
                                    <input type="file" name="image" class="form-control form-control-sm">
                                    <div class="form-text text-muted">Leave empty to keep current.</div>
                                </div>

                                <div class="col-md-9">
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Edit Title</label>
                                        <input type="text" name="title" value="${service.title}" class="form-control" required>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Edit Description</label>
                                        <textarea name="description" class="form-control" rows="3" required>${service.description}</textarea>
                                    </div>
                                    
                                    <div class="text-end">
                                        <button type="submit" class="btn btn-primary px-4">Update Changes</button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        `).join('')}
    </div>
` }) %>